# Modelo do backend para desenvolvimento local. Copie para backend/.env (não versionado).
# Combina com docker-compose.dev.yml na raiz do projeto.
NODE_ENV=development
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_helpdesk
DB_USER=smart_helpdesk
DB_PASSWORD=helpdesk_dev_local

# Gere um valor próprio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-local
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
APP_URL=http://localhost:5173

REDIS_URL=redis://127.0.0.1:6379

# E-mail da conta dona da plataforma (diagnóstico, manutenção, versões do agente). Vazio: ninguém.
PLATFORM_OWNER_EMAIL=

# Opcionais: sem eles as funções correspondentes ficam desligadas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=
GEMINI_API_KEY=
ALERT_WEBHOOK_URL=
CONSOLE_API_KEY=
