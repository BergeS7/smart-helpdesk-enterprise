# O Compose atual publica somente o portal na porta 8090.
# Backend e PostgreSQL permanecem restritos à rede Docker.

# Banco de dados
POSTGRES_DB=smart_helpdesk
POSTGRES_USER=smart_helpdesk
POSTGRES_PASSWORD=

# Autenticação
JWT_SECRET=
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=https://helpdesk.sua-empresa.com.br

# SMTP opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
