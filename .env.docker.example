# Copie este arquivo para .env e preencha os valores antes de iniciar.
# Nunca commite o arquivo .env real.

POSTGRES_DB=smart_helpdesk
POSTGRES_USER=smart_helpdesk
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=http://localhost:8090

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limiting distribuído (opcional). Sem esta variável, cada instância do
# backend usa memória local para limitar tentativas — adequado apenas com uma
# única instância. Definindo REDIS_URL, os limites passam a ser compartilhados
# entre instâncias via o serviço "redis" do docker-compose.
REDIS_URL=redis://redis:6379
